{
    "name": "dgtlss/easyerd",
    "description": "A Laravel package to generate ERD diagrams from models and migrations",
    "type": "laravel-package",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["laravel", "package", "erd", "diagram", "generator"],
    "homepage": "https://github.com/dgtlss/easyerd",
    "support": {
        "issues": "https://github.com/dgtlss/easyerd/issues",
        "source": "https://github.com/dgtlss/easyerd"
    },
    "authors": [
        {
            "name": "Nathan Langer",
            "email": "nathanlanger@googlemail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dgtlss\\EasyErd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dgtlss\\EasyErd\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dgtlss\\EasyErd\\EasyErdServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}